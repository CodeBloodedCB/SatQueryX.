# =============================================================================
# SatQuery AI - Environment Configuration
# =============================================================================

PORT=8000
DEBUG=False

# Preferred: Google AI Studio. One key enables native multimodal VLM + text.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenRouter fallback (OpenAI-compatible; supports multimodal models).
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://satqueryx-workspace.vercel.app

# Optional Groq text reasoning fallback.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI-compatible provider.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional local fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Render keep-alive. Leave blank when running locally.
SELF_PING_URL=https://satquery-backend-1809.onrender.com
KEEP_ALIVE_INTERVAL_SEC=600

# Frontend (Vite) uses this when running locally or when deploying elsewhere.
# VITE_API_URL=http://localhost:8000
